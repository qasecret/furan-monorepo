    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0"
  },
  "devDependencies": {
    "@furan/eslint-config": "workspace:*",
    "@furan/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
