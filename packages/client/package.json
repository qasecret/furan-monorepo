{
  "name": "@furan/client",
  "version": "0.0.0",
  "description": "Send screenshots to Furan from Node: create a build and runs, upload PNG checkpoints with ignore regions, and wait for the verdict.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/qasecret/furan-monorepo/blob/main/docs/integrations/javascript.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qasecret/furan-monorepo.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/qasecret/furan-monorepo/issues",
  "keywords": [
    "furan",
    "visual-testing",
    "screenshot",
    "visual-regression"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@furan/eslint-config": "workspace:*",
    "@furan/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^10.14.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
