{
  "name": "@furan/cli",
  "version": "0.1.0",
  "description": "furan upload: send PNG screenshots to Furan from any CI and fail the job when a screenshot needs review.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/qasecret/furan-monorepo/blob/main/docs/integrations/javascript.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qasecret/furan-monorepo.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/qasecret/furan-monorepo/issues",
  "keywords": [
    "furan",
    "visual-testing",
    "screenshot",
    "visual-regression",
    "cli"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "furan": "dist/bin.js"
  },
  "files": [
    "dist",
    "action.yml",
    "action"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@furan/client": "workspace:^"
  },
  "devDependencies": {
    "@furan/eslint-config": "workspace:*",
    "@furan/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
