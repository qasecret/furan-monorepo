{
  "name": "furan-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.7.2",
    "lefthook": "^1.10.0",
    "prettier": "^3.9.9"
  },
  "pnpm": {
    "comment-overrides": "CVE remediation for transitive deps flagged by the Trivy gate (v1.1.24) and pnpm audit (v1.1.30). Remove an entry once the dependency tree pulls the fix on its own. next>postcss: next 15.5.x pins postcss@8.4.31 exactly (GHSA advisories fixed in >=8.5.23).",
    "overrides": {
      "@grpc/grpc-js": "^1.14.5",
      "form-data": "^4.0.6",
      "next>postcss": "^8.5.29",
      "protobufjs": "^7.6.5",
      "ws": "^8.21.0"
    }
  }
}
