{
  "name": "furan-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.7.2",
    "lefthook": "^1.10.0",
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "comment-overrides": "CVE remediation for transitive deps flagged by the Trivy gate (v1.1.24). Remove an entry once the dependency tree pulls the fix on its own.",
    "overrides": {
      "@grpc/grpc-js": "^1.14.4",
      "form-data": "^4.0.6",
      "protobufjs": "^7.6.1",
      "ws": "^8.21.0"
    }
  }
}
