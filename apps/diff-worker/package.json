    "@furan/queue": "workspace:*",
    "@furan/storage": "workspace:^",
    "@furan/telemetry": "workspace:*",
    "ioredis": "^5.4.1",
    "jsdom": "^25.0.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35",
    "tesseract.js": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@furan/eslint-config": "workspace:*",
    "@furan/tsconfig": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
