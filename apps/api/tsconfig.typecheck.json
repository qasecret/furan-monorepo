{
  // The typecheck config: `src`, `scripts` and `tests` in one pass. The build
  // (`tsconfig.json`, `rootDir: "src"`) still checks that `src` imports
  // nothing from outside it, in `pnpm build`.
  "extends": "./tsconfig.json",
  "include": ["src", "scripts", "tests"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  }
}
