    "@furan/queue": "workspace:*",
    "@furan/storage": "workspace:^",
    "@furan/telemetry": "workspace:*",
    "ioredis": "^5.4.1",
    "playwright": "^1.49",
    "sharp": "^0.33",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@furan/eslint-config": "workspace:*",
    "@furan/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
