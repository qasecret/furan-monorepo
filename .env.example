# Furan monorepo env example. Phase 1 fills this in with `apps/api` keys
# (JWT_SECRET, POSTGRES_*, FURAN_DOMAIN, etc.) as those services land.
# Never commit `.env` — see `.gitignore`.

# Postgres 17 (P1.A)
POSTGRES_USER=furan
POSTGRES_PASSWORD="change-me-run: node -e \"console.log(require('crypto').randomBytes(24).toString('base64'))\""
POSTGRES_DB=furan_dev

# Redis 7 (P1.A) — no auth in v1.0 self-host (bind localhost-only)
# (Redis 7 has ACL support; v1.1+ may add username/password)

# MinIO (P1.A)
MINIO_ROOT_USER=furan
MINIO_ROOT_PASSWORD="change-me-run: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
MINIO_BUCKET=furan-dev

# apps/api (P1.C)
DATABASE_URL=postgresql://furan:devpw@localhost:5433/furan_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET="change-me-run: node -e \"console.log(require('crypto').randomBytes(48).toString('base64'))\""
JWT_EXPIRY=7d

# Optional first-admin bootstrap. When BOTH keys are set AND the users
# table is empty at API startup, the api seeds a single admin row with
# these credentials. Ignored once any user exists. The `seed-admin` CLI
# remains available for adding more admins or resetting passwords later.
#
# REPLACE BOTH PLACEHOLDERS before `docker compose up -d` — the API
# refuses to boot with `change-me*` values (same fail-closed pattern as
# JWT_SECRET).
FURAN_BOOTSTRAP_ADMIN_EMAIL="change-me"
FURAN_BOOTSTRAP_ADMIN_PASSWORD="change-me-run: openssl rand -hex 24"

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=furan-dev
S3_ACCESS_KEY=furan
S3_SECRET_KEY=devpw_must_be_long

# apps/dashboard (P1.D)
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS allowlist on apps/api for browser-side calls from the dashboard.
# Comma-separate to allow more than one origin. Default matches the
# self-host dashboard port. Override when serving the dashboard from a
# different origin (e.g. https://furan.example.com).
# FURAN_DASHBOARD_ORIGIN=http://localhost:3001

# Worker scaffolds (P1.D)
# CAPTURE_WORKER_PORT=3100
# DIFF_WORKER_PORT=3200

# Optional OTel
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info
