# Furan monorepo env example. Phase 1 fills this in with `apps/api` keys
# (JWT_SECRET, POSTGRES_*, FURAN_DOMAIN, etc.) as those services land.
# Never commit `.env` — see `.gitignore`.

# Postgres 17 (P1.A)
POSTGRES_USER=furan
POSTGRES_PASSWORD="change-me-run: node -e \"console.log(require('crypto').randomBytes(24).toString('base64'))\""
POSTGRES_DB=furan

# Redis 7 (P1.A) — no auth in v1.0 self-host (bind localhost-only)
# (Redis 7 has ACL support; v1.1+ may add username/password)

# MinIO (P1.A)
MINIO_ROOT_USER=furan
MINIO_ROOT_PASSWORD="change-me-run: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
MINIO_BUCKET=furan

# apps/api (P1.C)
# DATABASE_URL must match the postgres credentials above. Interpolated so
# rotating POSTGRES_PASSWORD doesn't silently break local-host test runs
# that source this file via `set -a; . ./.env; set +a` or via docker
# compose --env-file (both expand ${VAR}). Raw `docker run --env-file`
# does NOT interpolate — but that's not how this project is launched.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
# ADR-058 (optional): connection string for the non-owner `furan_app` role so
# Postgres row-level security applies to the API's queries as a tenant-isolation
# backstop. Leave UNSET to run the API as the owner role (RLS bypassed —
# backstop inactive). Enable only after: (1) migration 0032 created the role,
# (2) `ALTER ROLE furan_app LOGIN PASSWORD '…'`, (3) the RLS-enable migration
# has run. Only the API uses this; workers/CLIs/migrations use DATABASE_URL.
# DATABASE_URL_APP=postgresql://furan_app:${FURAN_APP_PASSWORD}@localhost:5433/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379
JWT_SECRET="change-me-run: node -e \"console.log(require('crypto').randomBytes(48).toString('base64'))\""
JWT_EXPIRY=7d

# Reverse-proxy trust (ADR-063): decides what the api treats as the client IP,
# which keys the per-IP login rate limit (10/min; a per-account limit of
# 10/15 min applies regardless). Leave UNSET (default) when clients reach the
# api directly — X-Forwarded-For is then ignored. Behind a reverse proxy, set
# the number of proxy hops in front of the api (`1` for the bundled nginx or a
# single Caddy/Traefik), or a comma-separated list of the proxies' IPs / CIDRs
# (`loopback`, `linklocal`, `uniquelocal` also accepted).
# WARNING: only trust a proxy the api is reachable EXCLUSIVELY through. If
# clients can also hit the api port directly, a hop count (or `true`, which
# trusts every hop) lets them forge X-Forwarded-For and dodge the per-IP limit
# — list the proxy's address instead. Unparseable values fail boot.
# TRUST_PROXY=1

# Optional first-admin bootstrap. When BOTH keys are set AND the users
# table is empty at API startup, the api seeds a single admin row with
# these credentials. Ignored once any user exists. The `seed-admin` CLI
# remains available for adding more admins or resetting passwords later.
#
# REPLACE BOTH PLACEHOLDERS before `docker compose up -d` — the API
# refuses to boot with `change-me*` values (same fail-closed pattern as
# JWT_SECRET).
FURAN_BOOTSTRAP_ADMIN_EMAIL="change-me"
FURAN_BOOTSTRAP_ADMIN_PASSWORD="change-me-run: openssl rand -hex 24"

# Storage backend selector (legacy parity with `STATIC_SERVICE`):
#   - `s3` (default): use MinIO inside compose or AWS S3 in real deploys.
#   - `hdd`: write to HDD_ROOT on the shared `furan_hdd_data` volume.
#     Single-host installs pick this to skip MinIO.
# See docs/runbooks/storage-backends.md for the full comparison.
STORAGE_KIND=s3
HDD_ROOT=/var/lib/furan/storage

# Docker Compose profiles. MinIO + minio-init are profile-gated so HDD
# installs can skip them; this default keeps the legacy behavior. Set
# to `hdd` to start the stack without MinIO.
COMPOSE_PROFILES=s3

# S3-compatible storage (MinIO in compose, or AWS S3 in real deploys).
# The credentials MUST match the MinIO root user/password above when using
# the bundled MinIO — apps/api signs requests with these and MinIO returns
# SignatureDoesNotMatch (a 403 buried inside a 500 chain) if they drift.
# Interpolated so they auto-track MINIO_ROOT_* without a second manual edit.
# Ignored when STORAGE_KIND=hdd.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=${MINIO_BUCKET}
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# apps/dashboard (P1.D)
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS allowlist on apps/api for browser-side calls from the dashboard.
# Comma-separate to allow more than one origin. Default matches the
# self-host dashboard port. Override when serving the dashboard from a
# different origin (e.g. https://furan.example.com).
# FURAN_DASHBOARD_ORIGIN=http://localhost:3001

# Worker scaffolds (P1.D)
# CAPTURE_WORKER_PORT=3100
# DIFF_WORKER_PORT=3200

# Optional OTel
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info
